{%- set s = impostazioni -%}
{%- set nomeSito = 'Effinge Art' if sezioneArt else s.sito.nome -%}
{%- set titoloPagina = (seo_titolo or titolo or title) -%}
{%- set descr = seo_descrizione or estratto or s.sito.descrizione -%}
{#- Titolo per Google: homepage dal pannello; testi «Titolo — Categoria | Effinge»; altre pagine «Titolo | Effinge» -#}
{%- if titolo_completo -%}{%- set titoloGoogle = titolo_completo -%}
{%- elif page.url == '/' -%}{%- set titoloGoogle = s.sito.titolo_home or s.sito.nome -%}
{%- elif layout == 'testo.njk' -%}{%- set titoloGoogle = titoloPagina + (' — ' + categoria if categoria else '') + ' | ' + s.sito.nome -%}
{%- elif titoloPagina -%}{%- set titoloGoogle = titoloPagina + ' | ' + s.sito.nome -%}
{%- else -%}{%- set titoloGoogle = s.sito.nome -%}{%- endif -%}
{%- set immagineSocial = (immagine or '/assets/effinge-anteprima.png') | assoluto(s.sito.indirizzo) -%}
<!doctype html>
<html lang="it" data-sfondo="{{ impostazioni.colori.sfondo or 'grafite' }}" style="--buio:{{ ((impostazioni.colori.buio if impostazioni.colori.buio is number else 55) / 100) }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="color-scheme" content="dark">
<meta name="theme-color" content="{{ s.colori.stanza | colore('#0A0A09') }}">
{%- if noindex or not s.sito.indicizza %}
<meta name="robots" content="noindex">
{%- endif %}
<title>{{ titoloGoogle }}</title>
<meta name="description" content="{{ descr }}">
<link rel="canonical" href="{{ page.url | assoluto(s.sito.indirizzo) }}">
<meta property="og:type" content="{{ 'article' if layout == 'testo.njk' else 'website' }}">
<meta property="og:site_name" content="{{ nomeSito }}">
<meta property="og:title" content="{{ (titoloPagina if page.url != '/' else titoloGoogle) or s.sito.nome }}">
<meta property="og:locale" content="it_IT">
<meta property="og:description" content="{{ descr }}">
<meta property="og:url" content="{{ page.url | assoluto(s.sito.indirizzo) }}">
<meta property="og:image" content="{{ immagineSocial }}">
{%- if not immagine %}
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Il foglio di Effinge nel buio, sotto una lampada">
{%- endif %}
<meta name="twitter:card" content="summary_large_image">
{%- if not noindex %}
<script type="application/ld+json">{{ { layout: layout, titolo: titolo, estratto: estratto, seo_descrizione: seo_descrizione, categoria: categoria, immagine: immagine, titolo_completo: titolo_completo, faq: faq } | jsonld(page, impostazioni) | safe }}</script>
{%- endif %}
<link rel="icon" type="image/png" sizes="96x96" href="/favicon.png">
<link rel="preload" href="/assets/fonts/cormorant-garamond-latin-300-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/inter-tight-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<script>if(window.top!==window.self){document.documentElement.style.visibility='hidden';try{window.top.location.replace(window.location.href)}catch(e){}}document.documentElement.classList.add('js');try{var f=localStorage.getItem('effinge-sfondo');if(f&&/^(grafite|vicious-stance|eternal-constance|midnight-bloom|solid-stone)$/.test(f))document.documentElement.setAttribute('data-sfondo',f);var b=localStorage.getItem('effinge-buio');if(b!==null&&b!==''&&isFinite(b))document.documentElement.style.setProperty('--buio',Math.min(1,Math.max(0,b/100)))}catch(e){}</script>
<link rel="stylesheet" href="/assets/css/fonts.css?v={{ build.versione }}">
<link rel="stylesheet" href="/assets/css/sito.css?v={{ build.versione }}">
{%- if stile %}
<link rel="stylesheet" href="{{ stile }}?v={{ build.versione }}">
{%- endif %}
<style>:root{--stanza:{{ s.colori.stanza | colore('#0A0A09') }};--carta:{{ (colore_carta or s.colori.carta) | colore(s.colori.carta | colore('#ECE7DC')) }};--inchiostro:{{ s.colori.inchiostro | colore('#1A1916') }};--testo:{{ s.colori.testo | colore('#E9E5DB') }};--luce:{{ s.lampada.colore | colore('#F0CB8A') }}}</style>
</head>
<body{% if sezioneArt %} class="art-sito"{% endif %}>
<a class="salta" href="#contenuto">Vai al contenuto</a>
{%- if sezioneArt %}
<header class="barra piena art-barra">
  <a class="marchio art-marchio" href="/art/" aria-label="Effinge Art, home"><span>Effinge</span><span class="barra-art">Art</span></a>
  <nav aria-label="Effinge Art">
    <a href="/art/#opere">Opere</a>
    <a href="/art/altre-opere/" class="facoltativo"{% if page.url == '/art/altre-opere/' %} aria-current="page"{% endif %}>Altre opere</a>
    <a href="/art/#commissioni">Contatti</a>
    <a href="/" class="facoltativo">Effinge</a>
    <button type="button" class="art-interruttore" data-art-luce aria-pressed="false" title="Luce piena: vedi i colori veri dei quadri"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.6 10.8c.7.6 1.1 1.3 1.1 2.2h5c0-.9.4-1.6 1.1-2.2A6 6 0 0 0 12 3z"/></svg><span class="nascosto">Luce piena sui quadri</span></button>
    {% include "sfondi.njk" %}
  </nav>
</header>
{%- else %}
<header class="barra{% if page.url != '/' %} piena{% endif %}">
  <a class="marchio" href="/" aria-label="{{ s.sito.nome }}, home">{{ s.sito.nome }}</a>
  <nav aria-label="Principale">
    {%- for p in collections.pagine %}{% if p.data.nel_menu %}
    <a href="{{ p.url }}"{% if page.url == p.url %} aria-current="page"{% endif %}{% if not loop.last or impostazioni.home.scrivi.nel_menu %} class="facoltativo"{% endif %}>{{ p.data.titolo }}</a>
    {%- endif %}{% endfor %}
    {%- if impostazioni.home.scrivi.nel_menu %}
    <a href="/scrivi/"{% if page.url == '/scrivi/' %} aria-current="page"{% endif %}>Scrivi</a>
    {%- endif %}
    <a href="/guide/"{% if page.url == '/guide/' %} aria-current="page"{% endif %}>Guide per chi scrive</a>
    <a class="barra-art" href="/art/" aria-label="Effinge Art">Art</a>
    {% include "sfondi.njk" %}
  </nav>
</header>
{%- endif %}
{{ content | safe }}
<footer class="piede" id="contatti">
  <span>{{ nomeSito }} © {{ build.anno }}</span>
  {%- if sezioneArt %}
  <span><a href="mailto:{{ effingeArt.contatto }}">{{ effingeArt.contatto }}</a> · <a href="/">Effinge</a></span>
  {%- else %}
  {%- if s.sito.piede %}<span>{{ s.sito.piede }}</span>{% endif %}
  <span><a href="/guide/">Guide per chi scrive</a> · <a href="/archivio/">Archivio</a></span>
  {%- endif %}
</footer>
<script src="/assets/js/sito.js?v={{ build.versione }}" defer></script>
{%- if script %}
<script src="{{ script }}?v={{ build.versione }}" defer></script>
{%- endif %}
</body>
</html>
