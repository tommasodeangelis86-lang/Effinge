      <div class="sfondi-scelta" id="sfondi-scelta" hidden>
        <div class="sfondi-tondi" role="radiogroup" aria-label="Sfondo">
        <button type="button" role="radio" data-scegli="grafite" aria-label="Grafite" title="Grafite"></button>
        <button type="button" role="radio" data-scegli="vicious-stance" aria-label="Vicious Stance" title="Vicious Stance"></button>
        <button type="button" role="radio" data-scegli="eternal-constance" aria-label="Eternal Constance" title="Eternal Constance"></button>
        <button type="button" role="radio" data-scegli="midnight-bloom" aria-label="Midnight Bloom" title="Midnight Bloom"></button>
