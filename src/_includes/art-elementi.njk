{% macro scrittura(s) -%}
data-scrittura-alla-vista data-enabled="{{ 'true' if s.animazione.attiva else 'false' }}" data-speed="{{ s.animazione.velocita }}" data-delay="{{ s.animazione.ritardo }}" data-fade="{{ s.animazione.dissolvenza }}" data-intensity="{{ (s.lampada.intensita or 80) / 100 }}" data-color="{{ s.lampada.colore | colore('#F0CB8A') }}" data-cursor="{{ 'true' if s.animazione.cursore else 'false' }}"
{%- endmacro %}

{% macro testo(s, durata) -%}
{{ scrittura(s) }} data-unita="parola" data-durata="{{ durata or 2200 }}"
{%- endmacro %}

{% macro richiedi(opera, contatto, classe) -%}
<a class="{{ classe or 'art-richiedi' }}" href="mailto:{{ contatto }}?subject={{ ('Effinge Art - ' + opera.titolo) | urlencode }}">Richiedi informazioni <span aria-hidden="true">→</span></a>
{%- endmacro %}

{% macro riga(opera, s, contatto) %}
<li class="art-voce">
  <div class="art-riga">
    <span class="art-miniatura art-lampada" data-lampada-scorrimento>
      <img src="{{ opera.immagine or ('/assets/art/' + opera.slug + '.webp') }}"{% if opera.width %} width="{{ opera.width }}" height="{{ opera.height }}"{% endif %} alt="" loading="lazy" decoding="async">
    </span>
    <div>
      <h3><a class="art-voce-link" href="/art/opere/{{ opera.slug }}/"><span class="art-gradiente" {{ scrittura(s) }}>{{ opera.titolo }}</span></a></h3>
      {%- if not opera.altra and opera.sommario %}<p {{ testo(s, 1200) }}>{{ opera.sommario }}</p>{% endif %}
      {%- if opera.stato %}<p class="art-stato">{{ opera.stato }}</p>{% endif %}
      {%- if opera.stato == 'Disponibile' and contatto %}{{ richiedi(opera, contatto) }}{% endif %}
    </div>
  </div>
</li>
{% endmacro %}
