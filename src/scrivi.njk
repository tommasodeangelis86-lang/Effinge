{%- elif nome == 'u' %}<path d="M7 4v7a5 5 0 0 0 10 0V4M5 20h14"/>
{%- elif nome == 's' %}<path d="M16 7.5C15.4 5.9 13.9 5 12 5c-2.5 0-4 1.3-4 3 0 1.4 1 2.3 2.6 2.9M4 12h16M8 16.5c.6 1.6 2.2 2.5 4.2 2.5 2.6 0 4.1-1.3 4.1-3.1 0-.7-.2-1.3-.6-1.8"/>
{%- elif nome == 'sx' %}<path d="M4 6h16M4 10h10M4 14h16M4 18h10"/>
{%- elif nome == 'ce' %}<path d="M4 6h16M7 10h10M4 14h16M7 18h10"/>
{%- elif nome == 'dx' %}<path d="M4 6h16M10 10h10M4 14h16M10 18h10"/>
{%- elif nome == 'gi' %}<path d="M4 6h16M4 10h16M4 14h16M4 18h16"/>
{%- elif nome == 'ul' %}<path d="M9 6h11M9 12h11M9 18h11"/><circle cx="4.5" cy="6" r="1.2"/><circle cx="4.5" cy="12" r="1.2"/><circle cx="4.5" cy="18" r="1.2"/>
{%- elif nome == 'ol' %}<path d="M10 6h10M10 12h10M10 18h10M4 4.5h1.5V9M3.5 9h3.5M3.5 14.5c.4-.6 1-.9 1.7-.9.9 0 1.6.6 1.6 1.4 0 1.3-3.3 2.6-3.3 4h3.4"/>
{%- elif nome == 'cit' %}<path d="M9 7H5v5h4v-5zm0 5c0 2.5-1.3 4-3.5 5M19 7h-4v5h4v-5zm0 5c0 2.5-1.3 4-3.5 5"/>
{%- elif nome == 'st' %}<path d="M12 8.5v7M8.97 10.25l6.06 3.5M15.03 10.25l-6.06 3.5"/>
{%- elif nome == 'un' %}<path d="M9 14 4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 0 1 0 11H11"/>
{%- elif nome == 're' %}<path d="m15 14 5-5-5-5"/><path d="M20 9H9.5a5.5 5.5 0 0 0 0 11H13"/>
{%- elif nome == 'cl' %}<path d="M4 7V5h11v2M9.5 5l-3 14M5 19h5M14 14l6 6M20 14l-6 6"/>
{%- elif nome == 'imp' %}<path d="M12 3v12M7 10l5 5 5-5M5 21h14"/>
{%- elif nome == 'esp' %}<path d="M12 15V3M7 8l5-5 5 5M5 21h14"/>
{%- elif nome == 'cap' %}<rect x="4" y="3" width="7" height="8" rx="1.5"/><rect x="4" y="13" width="7" height="8" rx="1.5"/><path d="M14 6h6M14 9h4M14 16h6M14 19h4"/>
{%- elif nome == 'su' %}<path d="m6 15 6-6 6 6"/>
{%- elif nome == 'giu' %}<path d="m6 9 6 6 6-6"/>
{%- elif nome == 'x' %}<path d="M6 6l12 12M18 6 6 18"/>
{%- elif nome == 'opere' %}<path d="M5 4h4v16H5zM10 4h4v16h-4zM15.5 4.6l3.8-1 3.7 15.5-3.8.9z"/>
{%- elif nome == 'conc' %}<path d="M12 4a8 8 0 1 0 0 16 8 8 0 1 0 0-16zM12 8.8a3.2 3.2 0 1 0 0 6.4 3.2 3.2 0 1 0 0-6.4z"/>
{%- elif nome == 'lamp' %}<path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.6 10.8c.6.5 1 1.2 1.1 2V16h5v-.2c.1-.8.5-1.5 1.1-2A6 6 0 0 0 12 3z"/>
{%- elif nome == 'pub' %}<path d="M4 12 20 4l-4 16-4-7-8-1z"/><path d="m12 13 8-9"/>
{%- elif nome == 'focus' %}<path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"/>
{%- elif nome == 'play' %}<path d="M8 5.5v13l10.5-6.5z"/>
{%- elif nome == 'stop' %}<rect x="7" y="7" width="10" height="10" rx="1.5"/>
