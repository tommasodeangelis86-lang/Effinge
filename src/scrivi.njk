{%- endmacro -%}

<main id="contenuto" class="scrivi-pagina" data-scrivi-app>
  <h1 class="sr">Foglio Effinge — editor di scrittura senza distrazioni</h1>
  <div class="scrivi-barra" role="toolbar" aria-label="Opera">
    <div class="barra-sx">
      <button type="button" class="pill solo-mobile" data-apri-capitoli aria-controls="capitoli" aria-expanded="false" aria-label="Capitoli" title="Capitoli">{{ icona('cap') }}<span>Capitoli</span></button>
      <button type="button" class="pill" data-comando="opere" aria-label="Opere" title="Opere">{{ icona('opere') }}<span>Opere</span></button>
      <label class="sr" for="nome-opera">Titolo dell’opera</label>
      <input id="nome-opera" class="nome-opera" type="text" autocomplete="off" spellcheck="false">
    </div>
    <div class="barra-centro">
      <button type="button" class="pill" data-comando="concentrazione" aria-pressed="true" aria-label="Concentrazione" title="Concentrazione">{{ icona('conc') }}<span>Concentrazione</span></button>
      <button type="button" class="pill" data-comando="lampada" aria-pressed="true" aria-label="Lampada" title="Lampada">{{ icona('lamp') }}<span>Lampada</span></button>
    </div>
    <div class="barra-dx">
      <button type="button" class="pill pubblica" data-comando="pubblica" aria-label="Pubblica sul sito" title="Pubblica sul sito" hidden>{{ icona('pub') }}<span>Pubblica sul sito</span></button>
      <button type="button" class="pill" data-comando="importa" aria-label="Importa da Word">{{ icona('imp') }}<span>Importa da Word</span></button>
      <button type="button" class="pill" data-comando="esporta" aria-label="Esporta in Word">{{ icona('esp') }}<span>Esporta in Word</span></button>
      <button type="button" class="pill focus" data-comando="focus" aria-pressed="false" aria-label="Focus: solo la pagina (Esc per uscire)" title="Focus: solo la pagina (Esc per uscire)"><span class="ic-entra">{{ icona('focus') }}</span><span class="ic-esci">{{ icona('esci') }}</span><span>Focus</span></button>
      <input type="file" accept=".docx,application/vnd.openxmlformats-officedocument.wordprocessingml.document" hidden data-file-word>
    </div>
  </div>

  <div class="scrivi-app">
    <!-- Sinistra: un’anteprima per ogni copertina, parte e capitolo, in ordine -->
    <aside class="capitoli" id="capitoli" aria-label="Capitoli">
      <div class="capitoli-testa">
        <h2>Capitoli</h2>
        <button type="button" class="chiudi-pannello solo-mobile" data-chiudi-capitoli aria-label="Chiudi i capitoli">{{ icona('x') }}</button>
      </div>
      <ol class="capitoli-elenco" data-capitoli></ol>
      <div class="capitoli-piede">
        <div class="aggiungi">
          <button type="button" data-nuova="capitolo">+ Capitolo</button>
          <button type="button" data-nuova="parte">+ Parte</button>
          <button type="button" data-nuova="copertina">+ Copertina</button>
        </div>
        <p class="totali" data-totali></p>
      </div>
    </aside>

    <!-- Centro: il foglio -->
    <div class="centro-foglio">
      <div class="scrivi-info">
        <span class="scrivi-stato" data-stato aria-live="polite"></span>
        <div class="scrivi-azioni" role="group" aria-label="Comandi del foglio">
          <button type="button" class="pill" data-riscrivi disabled data-speed="{{ impostazioni.animazione.velocita }}" data-fade="{{ impostazioni.animazione.dissolvenza }}" data-color="{{ impostazioni.lampada.colore | colore('#F0CB8A') }}" data-intensity="{{ impostazioni.lampada.intensita / 100 }}">Riscrivi</button>
          <button type="button" class="pill" data-comando="cartella" title="Battute per cartella: tocca per cambiare">Cartella 2000</button>
          <button type="button" class="pill" data-comando="manoscritto" aria-pressed="false" title="A4 · margini 2,3 cm · interlinea 1,5 · rientro 0,42 cm">Manoscritto</button>
        </div>
      </div>
      <div class="foglio scrivi-foglio">
        <div class="contenuto">
          <div class="scrivi-testa">
            <div class="scrivi-nome">
              <span class="scrivi-etichetta" data-etichetta></span>
              <label class="sr" for="titolo-sezione">Titolo</label>
              <input id="titolo-sezione" class="scrivi-titolo" type="text" autocomplete="off" spellcheck="true">
            </div>
          </div>
          <div class="scrivi-area">
            <div class="scrivi-editor" contenteditable="true" role="textbox" aria-multiline="true" aria-label="Testo" spellcheck="true" data-placeholder="Comincia a scrivere…"></div>
            <div class="scrivi-luci" aria-hidden="true"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Destra: formattazione, come in Word -->
    <aside class="formato" aria-label="Formattazione" role="toolbar" aria-orientation="vertical">
      <div class="gruppo">
        <h2>Stile</h2>
        <div class="stili">
          <button type="button" data-blocco="p" title="Normale" aria-label="Normale"><span class="breve" aria-hidden="true">¶</span><span class="lungo">Normale</span></button>
          <button type="button" data-blocco="h2" title="Sottotitolo" aria-label="Sottotitolo"><span class="breve" aria-hidden="true">Aa</span><span class="lungo">Sottotitolo</span></button>
          <button type="button" data-blocco="h3" title="Titoletto" aria-label="Titoletto"><span class="breve" aria-hidden="true">TT</span><span class="lungo">Titoletto</span></button>
          <button type="button" data-blocco="blockquote" title="Citazione" aria-label="Citazione"><span class="breve" aria-hidden="true">{{ icona('cit') }}</span><span class="lungo">Citazione</span></button>
        </div>
      </div>
      <div class="gruppo">
        <h2>Carattere</h2>
        <div class="icone">
          <button type="button" data-cmd="bold" aria-label="Grassetto (Ctrl+B)" title="Grassetto">{{ icona('b') }}</button>
          <button type="button" data-cmd="italic" aria-label="Corsivo (Ctrl+I)" title="Corsivo">{{ icona('i') }}</button>
          <button type="button" data-cmd="underline" aria-label="Sottolineato (Ctrl+U)" title="Sottolineato">{{ icona('u') }}</button>
          <button type="button" data-cmd="strikeThrough" aria-label="Barrato" title="Barrato">{{ icona('s') }}</button>
        </div>
      </div>
      <div class="gruppo">
        <h2>Paragrafo</h2>
        <div class="icone">
          <button type="button" data-cmd="justifyLeft" aria-label="Allinea a sinistra" title="Allinea a sinistra">{{ icona('sx') }}</button>
          <button type="button" data-cmd="justifyCenter" aria-label="Centra" title="Centra">{{ icona('ce') }}</button>
          <button type="button" data-cmd="justifyRight" aria-label="Allinea a destra" title="Allinea a destra">{{ icona('dx') }}</button>
          <button type="button" data-cmd="justifyFull" aria-label="Giustifica" title="Giustifica">{{ icona('gi') }}</button>
          <button type="button" data-cmd="insertUnorderedList" aria-label="Elenco puntato" title="Elenco puntato">{{ icona('ul') }}</button>
          <button type="button" data-cmd="insertOrderedList" aria-label="Elenco numerato" title="Elenco numerato">{{ icona('ol') }}</button>
        </div>
      </div>
      <div class="gruppo">
        <h2>Inserisci</h2>
        <div class="icone">
          <button type="button" data-inserisci="stacco" aria-label="Stacco tra scene (*)" title="Stacco tra scene">{{ icona('st') }}</button>
          <button type="button" data-blocco="blockquote" aria-label="Citazione" title="Citazione">{{ icona('cit') }}</button>
        </div>
      </div>
      <div class="gruppo gruppo-voce">
        <h2>Voce</h2>
        <div class="icone">
          <button type="button" data-voce="leggi" aria-pressed="false" aria-label="Leggi ad alta voce (seleziona un brano per leggere solo quello)" title="Leggi ad alta voce">{{ icona('play') }}</button>
          <button type="button" data-voce="ferma" aria-label="Ferma la voce (Esc)" title="Ferma">{{ icona('stop') }}</button>
          <button type="button" data-voce="impostazioni" aria-label="Voce e lettura mentre scrivi" title="Voce">{{ icona('voce') }}</button>
        </div>
      </div>
      <div class="gruppo gruppo-ai">
        <h2><span class="h-lungo">Suggerimenti</span><span class="h-breve" aria-hidden="true">AI</span></h2>
        <div class="stili">
          <button type="button" data-suggerisci="migliora" title="Migliora: refusi, ripetizioni, chiarezza" aria-label="Suggerimenti: migliora"><span class="breve" aria-hidden="true">{{ icona('migliora') }}</span><span class="lungo">Migliora</span></button>
          <button type="button" data-suggerisci="taglia" title="Taglia: ciò che è superfluo" aria-label="Suggerimenti: taglia"><span class="breve" aria-hidden="true">{{ icona('taglia') }}</span><span class="lungo">Taglia</span></button>
          <button type="button" data-suggerisci="stile" title="Stile: ritmo e immagini" aria-label="Suggerimenti: stile"><span class="breve" aria-hidden="true">{{ icona('stile') }}</span><span class="lungo">Stile</span></button>
          <button type="button" data-apri-chiavi title="Le mie chiavi AI" aria-label="Le mie chiavi AI"><span class="breve" aria-hidden="true">{{ icona('chiave') }}</span><span class="lungo">Chiavi AI</span></button>
        </div>
        <div class="ai-elenco" data-ai-elenco hidden><span data-ai-conta></span><button type="button" data-ai-cancella>Togli</button></div>
        <p class="voce-stato" data-voce-stato aria-live="polite"></p>
      </div>
      <div class="gruppo">
        <h2>Modifica</h2>
        <div class="icone">
          <button type="button" data-cmd="undo" aria-label="Annulla (Ctrl+Z)" title="Annulla">{{ icona('un') }}</button>
          <button type="button" data-cmd="redo" aria-label="Ripeti (Ctrl+Y)" title="Ripeti">{{ icona('re') }}</button>
          <button type="button" data-cmd="pulisci" aria-label="Cancella formattazione" title="Cancella formattazione">{{ icona('cl') }}</button>
        </div>
      </div>
    </aside>
  </div>
</main>

<div class="scrivi-guasto" id="scrivi-guasto" role="alert" hidden>
  <p><strong>La pagina non si è caricata del tutto.</strong> Ricaricala tenendo premuto Maiusc (sul computer: Ctrl + Maiusc + R, su Mac: Cmd + Maiusc + R). Se il problema resta, scrivimi.</p>
</div>

<p class="scrivi-nota">Foglio Effinge è uno strumento gratuito di scrittura immersiva online: ogni lettera si illumina mentre digiti, aiutandoti a superare il blocco dello scrittore. Quello che scrivi resta nel tuo browser. Guide: <a href="/guide/cartelle-editoriali/">contare le cartelle editoriali</a> · <a href="/guide/impaginare-manoscritto/">impaginare un manoscritto</a>.</p>

<dialog class="finestra" id="opere" aria-labelledby="h-opere">
  <div class="finestra-testa"><h2 id="h-opere">Le mie opere</h2><button type="button" class="pill" data-chiudi>Chiudi</button></div>
  <ul class="finestra-elenco" data-elenco-opere></ul>
  <div class="finestra-piede"><button type="button" class="pill primario" data-nuova-opera>Nuova opera</button><button type="button" class="pill" data-apri-autore>Accesso autore</button></div>
  <p class="finestra-nota">Le opere sono salvate solo in questo browser, su questo dispositivo. Per conservarle altrove usa «Esporta in Word».</p>
</dialog>

<dialog class="finestra" id="autore" aria-labelledby="h-autore">
  <div class="finestra-testa"><h2 id="h-autore">Accesso autore</h2><button type="button" class="pill" data-chiudi>Chiudi</button></div>
  <div class="finestra-corpo">
    <div data-autore-fuori>
      <p>Con l’accesso autore compare il pulsante <strong>Pubblica sul sito</strong>: il capitolo aperto diventa un testo di Effinge.</p>
      <p>Incolla qui la chiave personale che hai creato su GitHub (inizia con <code>github_pat_</code>). Resta solo in questo browser; va inserita una volta su ogni dispositivo.</p>
      <label class="campo"><span>Chiave GitHub</span><input type="password" id="chiave-autore" autocomplete="off" spellcheck="false" placeholder="github_pat_…"></label>
      <p class="esito" data-esito-autore aria-live="polite"></p>
    </div>
    <div data-autore-dentro hidden>
      <p data-autore-chi></p>
      <p>Per toglierla da questo dispositivo usa «Scollega». Per revocarla ovunque, eliminala dalle impostazioni di GitHub.</p>
    </div>
  </div>
  <div class="finestra-piede">
    <button type="button" class="pill primario" data-collega-autore>Collega</button>
    <button type="button" class="pill" data-scollega-autore hidden>Scollega</button>
  </div>
</dialog>

<dialog class="finestra" id="pubblica" aria-labelledby="h-pubblica">
  <div class="finestra-testa"><h2 id="h-pubblica">Pubblica sul sito</h2><button type="button" class="pill" data-chiudi>Annulla</button></div>
  <form class="finestra-corpo modulo" data-modulo-pubblica>
    <label class="campo"><span>Titolo</span><input type="text" id="pub-titolo" required autocomplete="off"></label>
    <div class="campi-due">
      <label class="campo"><span>Categoria</span><input type="text" id="pub-categoria" list="pub-categorie" autocomplete="off" placeholder="es. Racconto"></label>
      <label class="campo"><span>Data</span><input type="date" id="pub-data" required></label>
    </div>
    <datalist id="pub-categorie"><option value="Racconto"><option value="Capitolo"><option value="Frammento"><option value="Prosa breve"><option value="Nota"><option value="Poesia"></datalist>
    <label class="campo"><span>Estratto <small>(per la homepage e le anteprime sui social)</small></span><textarea id="pub-estratto" rows="3"></textarea></label>
    <label class="campo"><span>Descrizione per Google <small>(facoltativa, circa 155 caratteri: di cosa parla il testo)</small></span><textarea id="pub-seo" rows="2" maxlength="300"></textarea></label>
    <label class="spunta"><input type="checkbox" id="pub-evidenza"> In evidenza in homepage</label>
    <fieldset class="scelta">
      <legend>Come</legend>
      <label class="spunta"><input type="radio" name="pub-modo" value="pubblica" checked> Pubblica subito</label>
      <label class="spunta"><input type="radio" name="pub-modo" value="bozza"> Salva come bozza (visibile solo in anteprima)</label>
    </fieldset>
    <p class="esito" data-esito-pubblica aria-live="polite"></p>
  </form>
  <div class="finestra-piede"><button type="button" class="pill primario" data-conferma-pubblica>Pubblica</button></div>
  <p class="finestra-nota">Viene pubblicato il testo del capitolo aperto. Dopo puoi modificarlo dal pannello, oppure ripubblicarlo da qui: il testo sul sito viene aggiornato.</p>
</dialog>

<dialog class="finestra" id="voce" aria-labelledby="h-voce">
  <div class="finestra-testa"><h2 id="h-voce">Voce</h2><button type="button" class="pill" data-chiudi>Chiudi</button></div>
  <div class="finestra-corpo modulo">
    <fieldset class="scelta">
      <legend>Chi legge</legend>
      <label class="spunta"><input type="radio" name="voce-motore" value="sistema"> Voce del sistema <small>gratis, già nel tuo dispositivo</small></label>
      <label class="spunta"><input type="radio" name="voce-motore" value="openai"> OpenAI <small>con la tua chiave, a consumo</small></label>
      <label class="spunta"><input type="radio" name="voce-motore" value="elevenlabs"> ElevenLabs <small>con la tua chiave, a consumo</small></label>
    </fieldset>
    <label class="campo" data-motore-campo="sistema"><span>Voce</span><select id="voce-sistema"></select></label>
    <label class="campo" data-motore-campo="openai" hidden><span>Voce</span><select id="voce-openai">
      <option value="nova">Nova</option><option value="shimmer">Shimmer</option><option value="alloy">Alloy</option><option value="echo">Echo</option><option value="fable">Fable</option><option value="onyx">Onyx</option>
    </select></label>
    <label class="campo" data-motore-campo="elevenlabs" hidden><span>Voce</span><select id="voce-eleven">
      <option value="21m00Tcm4TlvDq8ikWAM">Rachel</option><option value="EXAVITQu4vr4xnSDxMaL">Bella</option><option value="AZnzlk1XvdvUeBnXmlld">Domi</option><option value="ErXwobaYiN019PkySvjV">Antoni</option><option value="TxGEqnHWrfWFTfGW9XjX">Josh</option><option value="pNInz6obpgDQGcFmaJgB">Adam</option><option value="yoZ06aMxZJJ28mfd3POQ">Sam</option><option value="VR6AewLTigWG4xSOukaG">Arnold</option>
    </select></label>
    <p class="esito" data-manca-chiave hidden>Per questa voce serve la tua chiave. <button type="button" class="pill" data-vai-chiavi>Aggiungi la chiave</button></p>
    <label class="campo"><span>Velocità</span><select id="voce-velocita"><option value="0.75">0,75×</option><option value="1">1×</option><option value="1.25">1,25×</option><option value="1.5">1,5×</option><option value="2">2×</option></select></label>
    <fieldset class="scelta">
      <legend>Mentre scrivi</legend>
      <label class="spunta"><input type="radio" name="voce-modo" value="manuale"> Manuale <small>legge solo quando tocchi Leggi</small></label>
      <label class="spunta"><input type="radio" name="voce-modo" value="frase"> Frase <small>legge ogni frase appena la chiudi col punto</small></label>
      <label class="spunta"><input type="radio" name="voce-modo" value="auto"> Auto <small>legge le parole nuove dopo una pausa di un secondo e mezzo</small></label>
    </fieldset>
  </div>
  <div class="finestra-piede"><button type="button" class="pill primario" data-prova-voce>Prova la voce</button></div>
  <p class="finestra-nota">La parola letta si accende sotto la lampada. Su iPhone e iPad la prima volta tocca «Leggi»: il sistema fa partire la voce solo dopo un tocco.</p>
</dialog>

<dialog class="finestra" id="chiavi-ai" aria-labelledby="h-chiavi">
  <div class="finestra-testa"><h2 id="h-chiavi">Le mie chiavi AI</h2><button type="button" class="pill" data-chiudi>Chiudi</button></div>
  <div class="finestra-corpo modulo">
    <p>Voci premium e suggerimenti usano le <strong>tue</strong> chiavi API: paghi tu il consumo, direttamente al fornitore. Le chiavi restano in questo browser e vengono inviate solo al fornitore, mai a Effinge. L’abbonamento a ChatGPT o a Claude non include le chiavi API: si creano a parte, nelle console dei fornitori.</p>
    <label class="campo"><span>Suggerimenti con</span><select id="ai-fornitore"><option value="anthropic">Claude (Anthropic)</option><option value="openai">OpenAI</option><option value="gemini">Gemini (Google)</option></select></label>
    <div class="campi-due">
      <label class="campo"><span>Chiave Claude <small>console.anthropic.com</small></span><input type="password" id="chiave-anthropic" autocomplete="off" spellcheck="false" data-esempio="sk-ant-…"></label>
      <label class="campo"><span>Modello Claude</span><input type="text" id="modello-anthropic" autocomplete="off" spellcheck="false"></label>
    </div>
    <div class="campi-due">
      <label class="campo"><span>Chiave OpenAI <small>voci e suggerimenti</small></span><input type="password" id="chiave-openai" autocomplete="off" spellcheck="false" data-esempio="sk-…"></label>
      <label class="campo"><span>Modello OpenAI</span><input type="text" id="modello-openai" autocomplete="off" spellcheck="false"></label>
    </div>
    <div class="campi-due">
      <label class="campo"><span>Chiave Gemini <small>aistudio.google.com</small></span><input type="password" id="chiave-gemini" autocomplete="off" spellcheck="false" data-esempio="AIza…"></label>
      <label class="campo"><span>Modello Gemini</span><input type="text" id="modello-gemini" autocomplete="off" spellcheck="false"></label>
    </div>
    <label class="campo"><span>Chiave ElevenLabs <small>solo voci</small></span><input type="password" id="chiave-elevenlabs" autocomplete="off" spellcheck="false" data-esempio="…"></label>
    <label class="spunta"><input type="checkbox" id="chiavi-ricorda" checked> Ricorda in questo browser <small>se lo togli, le chiavi si cancellano chiudendo la scheda</small></label>
  </div>
  <div class="finestra-piede"><button type="button" class="pill primario" data-salva-chiavi>Salva</button><button type="button" class="pill" data-cancella-chiavi>Cancella tutte</button></div>
  <p class="finestra-nota">Un campo lasciato vuoto non cambia la chiave già salvata. Su un computer condiviso togli «Ricorda» o usa «Cancella tutte» quando hai finito.</p>
</dialog>

<dialog class="finestra" id="importa" aria-labelledby="h-importa">
  <div class="finestra-testa"><h2 id="h-importa">Importa da Word</h2><button type="button" class="pill" data-chiudi>Annulla</button></div>
  <div class="finestra-corpo" data-riepilogo-import></div>
  <div class="finestra-piede"><button type="button" class="pill primario" data-conferma-import>Crea l’opera</button></div>
  <p class="finestra-nota">Il file resta sul tuo dispositivo: viene letto dal browser e non viene inviato a nessuno.</p>
</dialog>
