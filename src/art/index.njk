---
layout: base.njk
permalink: /art/
sezioneArt: true
stile: /assets/css/art.css
titolo: Effinge Art
titolo_completo: Effinge Art — Galleria di pittura
seo_descrizione: "Esplora la galleria Effinge Art. Paesaggi, ritratti, nature morte e informazioni sulle opere disponibili e su commissione."
immagine: /assets/art/naples-1882.webp
---
{% from "art-elementi.njk" import riga, scrittura, testo %}
<main id="contenuto" class="art-main">
  <section class="art-apertura art-contenitore" aria-labelledby="titolo-art">
    <h1 id="titolo-art" class="nascosto">Effinge Art</h1>
    <div class="art-introduzione">
      <p class="art-etichetta">Effinge Art</p>
      {%- for p in effingeArt.presentazione %}
      <p class="art-presentazione" {{ testo(impostazioni, 2600) }}>{{ p }}</p>
      {%- endfor %}
      <div class="art-artista">
        <img class="art-cerchio" src="/assets/art/ritratto.webp" width="864" height="1184" alt="Ritratto dell’artista in galleria" fetchpriority="high" decoding="async">
        {%- if effingeArt.social and effingeArt.social.length %}
        <div class="art-social" aria-label="Social">
          {%- for x in effingeArt.social %}{% if (x.indirizzo | string).indexOf('https://') == 0 %}<a href="{{ x.indirizzo }}" target="_blank" rel="noopener">{{ x.nome }}</a>{% endif %}{% endfor %}
        </div>
        {%- endif %}
      </div>
      <div id="commissioni" class="art-commissioni">
        <p class="art-etichetta">Commissioni</p>
        {%- if effingeArt.commissioni %}<p class="art-commissioni-testo" {{ testo(impostazioni, 1600) }}>{{ effingeArt.commissioni }}</p>{% endif %}
        <div class="art-commissioni-azioni">
          <a class="art-azione" href="mailto:{{ effingeArt.contatto }}">Scrivici per informazioni</a>
          <span class="art-mail">{{ effingeArt.contatto }}</span>
        </div>
      </div>
    </div>
    <div class="art-mosaico-scena">
      <div class="art-mosaico" data-art-mosaico>
        {%- set n = 0 %}
        {%- for opera in effingeArt.opere %}{% if opera.nel_mosaico %}
        <a class="art-tessera" href="/art/opere/{{ opera.slug }}/" style="--i:{{ loop.index0 }}"><img src="{{ opera.immagine or ('/assets/art/' + opera.slug + '.webp') }}" alt="" decoding="async"><span class="nascosto">{{ opera.titolo }}</span></a>
        {%- endif %}{% endfor %}
      </div>
    </div>
  </section>

  <section id="opere" class="art-contenitore art-sezione" aria-labelledby="titolo-opere">
    <h2 id="titolo-opere" class="art-gradiente" {{ scrittura(impostazioni) }}>{{ effingeArt.titolo_opere }}</h2>
    <ul class="art-galleria">
      {%- for opera in effingeArt.opere %}{% if not opera.altra %}
      {{ riga(opera, impostazioni, effingeArt.contatto) }}
      {%- endif %}{% endfor %}
    </ul>
  </section>

  <section class="art-contenitore art-sezione art-evento" aria-labelledby="titolo-evento">
    <figure class="art-lampada" data-lampada-scorrimento>
      <img src="/assets/art/rome-art-week.webp" width="1440" height="810" alt="Opere esposte a Rome Art Week 2025" loading="lazy" decoding="async">
    </figure>
    <div>
      <h2 id="titolo-evento" class="art-gradiente" {{ scrittura(impostazioni) }}>{{ effingeArt.titolo_evento }}</h2>
    </div>
  </section>

  <section class="art-contenitore art-sezione" aria-labelledby="titolo-altre">
    <h2 id="titolo-altre" class="art-gradiente" {{ scrittura(impostazioni) }}>{{ effingeArt.titolo_altre }}</h2>
    <ul class="art-galleria art-galleria--altre">
      {%- for opera in effingeArt.opere %}{% if opera.altra %}
      {{ riga(opera, impostazioni, effingeArt.contatto) }}
      {%- endif %}{% endfor %}
    </ul>
    <a class="art-azione art-azione--secondaria" href="/art/altre-opere/">Vedi le altre opere</a>
  </section>
</main>
