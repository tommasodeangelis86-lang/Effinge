---
layout: base.njk
sezioneArt: true
stile: /assets/css/art.css
pagination:
  data: effingeArt.opere
  size: 1
  alias: opera
permalink: /art/opere/{{ opera.slug }}/
eleventyComputed:
  titolo: "{{ opera.titolo }}"
  titolo_completo: "{{ opera.titolo }} | Effinge Art"
  seo_descrizione: "{{ opera.sommario }}"
  immagine: "{{ opera.immagine or ('/assets/art/' + opera.slug + '.webp') }}"
---
{% from "art-elementi.njk" import scrittura, testo %}
<main id="contenuto" class="art-main art-contenitore art-dettaglio">
  <a class="art-ritorno" href="{{ '/art/altre-opere/' if opera.altra else '/art/#opere' }}">{{ 'Altre opere' if opera.altra else 'Tutte le opere' }}</a>
  <article class="art-opera{% if opera.fotoADestra %} art-opera--rovesciata{% endif %}" aria-labelledby="titolo-opera">
    <header class="art-opera-testa">
      <h1 id="titolo-opera" class="art-gradiente" {{ scrittura(impostazioni) }}>{{ opera.titolo }}</h1>
      <p {{ testo(impostazioni, 1200) }}>{{ opera.sommario }}</p>
      {%- if opera.contesto %}<p {{ testo(impostazioni, 900) }}>{{ opera.contesto }}</p>{% endif %}
      {%- if opera.stato %}<p class="art-stato">{{ opera.stato }}{% if opera.prezzo %} · {{ opera.prezzo }}{% endif %}</p>{% endif %}
    </header>
    <figure class="art-opera-foto">
      <div class="art-lampada" data-lampada-scorrimento>
        <img src="{{ opera.immagine or ('/assets/art/' + opera.slug + '.webp') }}"{% if opera.width %} width="{{ opera.width }}" height="{{ opera.height }}"{% endif %} alt="{{ opera.alt or opera.titolo }}" fetchpriority="high" decoding="async">
        <button type="button" class="art-tocca" data-art-luce aria-pressed="false"><span class="nascosto">Luce piena sul quadro</span></button>
      </div>
      <figcaption class="art-didascalia"><span class="spenta">Tocca il quadro per vederne i colori veri</span><span class="accesa">Tocca di nuovo per tornare alla lampada</span></figcaption>
    </figure>
    {%- if opera.testo.length or opera.stato == 'Disponibile' %}
    <div class="art-opera-testo">
      {%- for paragrafo in opera.testo %}<p {{ testo(impostazioni, 2800) }}>{{ paragrafo }}</p>{% endfor %}
      {%- if opera.stato == 'Disponibile' %}
      <a class="art-azione" href="mailto:{{ effingeArt.contatto }}?subject={{ ('Effinge Art - ' + opera.titolo) | urlencode }}">Chiedi informazioni</a>
      {%- endif %}
    </div>
    {%- endif %}
  </article>
  {%- if pagination.href.previous or pagination.href.next %}
  <nav class="art-opera-nav" aria-label="Altre opere di Effinge Art">
    {%- if pagination.href.previous %}<a href="{{ pagination.href.previous }}">Opera precedente</a>{% endif %}
    {%- if pagination.href.next %}<a href="{{ pagination.href.next }}">Opera successiva</a>{% endif %}
  </nav>
  {%- endif %}
</main>
