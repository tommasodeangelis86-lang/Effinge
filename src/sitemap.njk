---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ '/' | assoluto(impostazioni.sito.indirizzo) }}</loc></url>
  <url><loc>{{ '/archivio/' | assoluto(impostazioni.sito.indirizzo) }}</loc></url>
  {%- for p in collections.pagine %}
  <url><loc>{{ p.url | assoluto(impostazioni.sito.indirizzo) }}</loc></url>
  {%- endfor %}
  {%- for t in collections.testi %}
  <url><loc>{{ t.url | assoluto(impostazioni.sito.indirizzo) }}</loc><lastmod>{{ t.date | dataIso }}</lastmod></url>
  {%- endfor %}
</urlset>
