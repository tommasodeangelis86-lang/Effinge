---
layout: base.njk
permalink: /
---
{%- set s = impostazioni -%}
{%- set a = s.animazione -%}
{%- macro parametriScrittura(velocita, ritardo) -%}
data-enabled="{{ 'true' if a.attiva else 'false' }}" data-speed="{{ velocita }}" data-delay="{{ ritardo }}" data-fade="{{ a.dissolvenza }}" data-intensity="{{ (s.lampada.intensita or 80) / 100 }}" data-color="{{ s.lampada.colore | colore('#F0CB8A') }}" data-cursor="{{ 'true' if a.cursore else 'false' }}"
{%- endmacro -%}
{%- macro scritturaAllaVista() -%}
data-scrittura-alla-vista {{ parametriScrittura(a.velocita, a.ritardo) }}
{%- endmacro -%}
{%- macro scritturaRiga() -%}
data-scrittura {{ parametriScrittura((a.velocita or 85) / 3, 0) }}
{%- endmacro -%}
<main id="contenuto">
  <section class="apertura" aria-label="Apertura">
    <div class="palco">
      <div class="foglio">
        <div class="contenuto">
          <div class="intestazione"><span aria-hidden="true">{{ s.apertura.intestazione_sinistra }}</span><h2 class="intestazione-h">{{ s.apertura.intestazione_destra }}</h2></div>
          <h1 class="titolo" data-scrittura {{ parametriScrittura(a.velocita, a.ritardo) }} data-repeat="{{ a.ripetizione or 'sempre' }}">{{ s.apertura.scritta }}</h1>
          {%- if s.progetto.mostra and s.progetto.righe.length %}
          <div class="apertura-progetto" id="progetto"{% if s.progetto.titolo %} role="group" aria-label="{{ s.progetto.titolo }}"{% endif %}>
            {%- for r in s.progetto.righe %}
            <p {{ scritturaRiga() }}>{{ r }}</p>
            {%- endfor %}
          </div>
          {%- endif %}
          {%- if s.apertura.sottotitolo %}
          <p class="sottotitolo" {{ scritturaRiga() }}>{{ s.apertura.sottotitolo }}</p>
          {%- endif %}
          <div class="firma" aria-hidden="true"><span>{{ s.apertura.firma_sinistra }}</span><span>{{ s.apertura.firma_destra }}</span></div>
        </div>
      </div>
      <div class="indizio" aria-hidden="true">Scorri<i></i></div>
      {%- if a.attiva %}
      <button class="riaccendi" type="button" data-riaccendi hidden>Riscrivi</button>
      {%- endif %}
    </div>
  </section>

  {%- set ultimo = collections.testi[0] %}
  {%- set sc = s.home.scrivi %}
  {%- if sc.mostra %}
  <section class="sezione scrivi-invito" id="scrivi" aria-labelledby="h-scrivi">
    <div class="scrivi-invito-griglia">
      <div class="scrivi-invito-testo">
        <h2 id="h-scrivi" {{ scritturaAllaVista() }}>{{ sc.titolo }}</h2>
        <div class="sale">
          {%- if sc.testo %}<p>{{ sc.testo }}</p>{% endif %}
          <a class="pulsante" href="/scrivi/">{{ sc.pulsante }} <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <a class="foglio scrivi-anteprima sale" href="/scrivi/" data-scrittura-al-passaggio aria-label="{{ sc.pulsante }}">
        <div class="contenuto">
          <div class="intestazione" aria-hidden="true"><span>Foglio</span><span>{{ s.sito.nome }}</span></div>
          <p class="scrivi-anteprima-frase" data-scrittura data-speed="{{ s.animazione.velocita }}" data-delay="200" data-fade="{{ s.animazione.dissolvenza }}" data-intensity="{{ (s.lampada.intensita or 80) / 100 }}" data-color="{{ s.lampada.colore | colore('#F0CB8A') }}" data-cursor="true" data-repeat="sempre">{{ sc.frase_foglio }}</p>
          <div class="scrivi-anteprima-righe" aria-hidden="true"><i></i><i></i><i></i></div>
        </div>
      </a>
    </div>
  </section>
  {%- endif %}

  <section class="sezione scrivi-invito" id="checklist" aria-labelledby="h-checklist">
    <div class="scrivi-invito-griglia">
      <div class="scrivi-invito-testo">
        <h2 id="h-checklist" {{ scritturaAllaVista() }}>Checklist manoscritto</h2>
        <div class="sale">
          <p>Controlla impaginazione e capitoli del tuo file Word. Sistema il formato e scarica una nuova copia.</p>
          <a class="pulsante" href="/checkmanoscritto/">Apri la checklist <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <a class="foglio scrivi-anteprima checklist-anteprima" href="/checkmanoscritto/" data-lampada-puntatore aria-label="Apri la checklist manoscritto">
        <div class="contenuto" aria-hidden="true">
          <ul class="checklist-anteprima-voci">
            <li>Impaginazione</li>
            <li>Capitoli</li>
            <li>Frontespizio</li>
          </ul>
        </div>
      </a>
    </div>
  </section>

  {%- if collections.strumenti.length %}
  <section class="sezione guide-invito" id="strumenti" aria-labelledby="h-strumenti">
    <div class="sezione-testa">
      <h2 id="h-strumenti" {{ scritturaAllaVista() }}>Strumenti</h2>
      <a href="/strumenti/">Tutti gli strumenti <span aria-hidden="true">→</span></a>
    </div>
    <ul class="guide-invito-griglia strumenti-invito-griglia">
      {%- for strumento in collections.strumenti %}
      <li>
        <a class="foglio guide-invito-scheda" href="{{ strumento.url }}" data-lampada-puntatore>
          <h3>{{ strumento.data.titolo }}</h3>
          <span aria-hidden="true">→</span>
        </a>
      </li>
      {%- endfor %}
    </ul>
  </section>
  {%- endif %}

  {%- if collections.guide.length %}
  {%- set limiteGuide = 6 %}
  {%- set altreGuide = collections.guide.length > limiteGuide %}
  <section class="sezione guide-invito" id="guide" aria-labelledby="h-guide">
    <div class="sezione-testa">
      <h2 id="h-guide" {{ scritturaAllaVista() }}>Guide per chi scrive</h2>
      {%- if not altreGuide %}
      <a href="/guide/">Tutte le guide <span aria-hidden="true">→</span></a>
      {%- endif %}
    </div>
    <ul class="guide-invito-griglia">
      {%- for guida in collections.guide | limita(limiteGuide) %}
      <li>
        <a class="foglio guide-invito-scheda" href="{{ guida.url }}" data-lampada-puntatore>
          <h3>{{ guida.data.titolo }}</h3>
          <span aria-hidden="true">→</span>
        </a>
      </li>
      {%- endfor %}
    </ul>
    {%- if altreGuide %}
    <div class="guide-invito-altre">
      <a class="pulsante" href="/guide/">Vedi altre guide <span aria-hidden="true">→</span></a>
    </div>
    {%- endif %}
  </section>
  {%- endif %}

  {%- if s.home.mostra_ultimo and ultimo %}
  <section class="sezione" id="ultimo" aria-labelledby="h-ultimo">
    <div class="sezione-testa"><h2 id="h-ultimo" {{ scritturaAllaVista() }}>Quaderni</h2></div>
    <article class="ultimo sale">
      <a class="foglio" href="{{ ultimo.url }}" data-lampada-puntatore{% if ultimo.data.colore_carta | colore(false) %} style="--carta:{{ ultimo.data.colore_carta }}"{% endif %}>
        <div class="contenuto">
          <h3>{{ ultimo.data.titolo }}</h3>
          <div>
            {%- if ultimo.data.estratto %}<p>{{ ultimo.data.estratto }}</p>{% endif %}
            <div class="meta">{% if ultimo.data.categoria %}{{ ultimo.data.categoria }} · {% endif %}<time datetime="{{ ultimo.date | dataIso }}">{{ ultimo.date | dataEstesa }}</time></div>
            <p style="margin:2.4cqw 0 0"><span class="leggi">Leggi il testo <span aria-hidden="true">→</span></span></p>
          </div>
        </div>
      </a>
    </article>
  </section>
  {%- endif %}

  {%- if s.home.mostra_archivio and collections.testi.length > 1 %}
  <section class="sezione" id="archivio" aria-labelledby="h-archivio">
    <div class="sezione-testa sale"><h2 id="h-archivio">Dall’archivio</h2><a href="/archivio/">Tutto l’archivio →</a></div>
    <ul class="archivio sale">
      {%- for t in collections.testi.slice(1) | inEvidenza(s.home.quanti_in_archivio or 4) %}
      <li><a href="{{ t.url }}"><span class="t">{{ t.data.titolo }}</span><span class="c">{{ t.data.categoria }}</span><span class="d">{{ t.date | dataBreve }}</span></a></li>
      {%- endfor %}
    </ul>
  </section>
  {%- endif %}

  {%- if s.home.congedo %}
  <section class="chiusura" aria-label="Congedo">
    <p class="sale">{{ s.home.congedo }}</p>
  </section>
  {%- endif %}
</main>
